{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "softpulze/laravibe-vue",
    "type": "project",
    "description": "Open-source Laravel + Vue 3 starter kit with Inertia, Vite, Tailwind CSS, Shadcn Vue, and reusable utilities—optimized for clean structure and fast development. Build your app, skip the boilerplate.",
    "keywords": [
        "laravel",
        "php",
        "inertia",
        "vue",
        "starter-kit",
        "laravibe",
        "open-source"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ashok Barua",
            "email": "ashokbaruaakas@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.38",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.23",
        "thesoftpulze/laravibe-standards": "^0.7.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/Helpers.php",
            "app/Toast/Support/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "queue": "@php artisan queue:listen --tries=1 --timeout=0 --queue=default",
        "logs": "@php artisan pail -v --timeout=0",
        "vite": "npm run dev",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact --coverage"
        ],
        "pest": "./vendor/bin/pest --compact",
        "pest:coverage": "./vendor/bin/pest --coverage --compact",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "pint": "./vendor/bin/pint --parallel",
        "pint:check": "./vendor/bin/pint --parallel --test",
        "rector": "./vendor/bin/rector",
        "rector:check": "./vendor/bin/rector --dry-run",
        "format": [
            "@pint",
            "npm run format"
        ],
        "format:check": [
            "@pint:check",
            "npm run format:check"
        ],
        "lint": [
            "@rector",
            "npm run lint"
        ],
        "lint:check": [
            "@rector:check",
            "npm run lint:check"
        ],
        "types:check": [
            "@phpstan",
            "npm run types:check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@format:check",
            "@types:check",
            "@test"
        ],
        "review": [
            "@ci:check"
        ],
        "build": "npm run build",
        "build:ssr": "npm run build:ssr",
        "update:composer": "composer update",
        "update:npm": "npm update",
        "deps:update": [
            "@update:composer",
            "@update:npm"
        ],
        "logs:delete": "find storage/logs -name \"*.log\" -delete",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php -r \"if (getenv('COMPOSER_DEV_MODE') === '1') { passthru(escapeshellarg(PHP_BINARY) . ' artisan ide-helper:generate && ' . escapeshellarg(PHP_BINARY) . ' artisan ide-helper:meta'); }\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
