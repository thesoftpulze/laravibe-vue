# ── Dependencies ─────────────────────────────────────────────────────────────
/vendor
/node_modules

# ── Secrets and environment files ────────────────────────────────────────────
.env
.env.backup
.env.production
/auth.json

# ── Build output ─────────────────────────────────────────────────────────────
/public/build
/public/fonts-manifest.dev.json
/bootstrap/ssr

# ── Runtime-generated files ───────────────────────────────────────────────────
/public/hot
/public/storage
/storage/*.key
/storage/pail

# ── Test cache ───────────────────────────────────────────────────────────────
/.phpunit.cache
.phpunit.result.cache

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store

# ── IDE and editor tooling ────────────────────────────────────────────────────
/.fleet
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
.phpstorm.meta.php

# ── IDE Helper generated files ────────────────────────────────────────────────
_ide_helper.php
_ide_helper_models.php

# ── Vagrant (legacy) ─────────────────────────────────────────────────────────
Homestead.json
Homestead.yaml

# ── Debug logs ───────────────────────────────────────────────────────────────
npm-debug.log
yarn-error.log

# ── Wayfinder generated output ───────────────────────────────────────────────
/resources/actions
/resources/routes
/resources/wayfinder
# Wayfinder's package default; catches output generated with a stray --path
/resources/js

